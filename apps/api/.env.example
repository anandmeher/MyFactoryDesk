# Database (host port remapped to 5433 — see docker-compose.yml)
DATABASE_URL=postgresql://app:app@localhost:5433/myfactorydesk

# Cache / Queue (host port remapped to 6380 — see docker-compose.yml)
REDIS_URL=redis://localhost:6380

# JWT (generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=replace_me_with_32_byte_hex
JWT_REFRESH_SECRET=replace_me_with_32_byte_hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# PII encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=replace_me_with_32_byte_hex

# Runtime
NODE_ENV=development
# Port 3000 is commonly taken by Next.js / other dev servers — defaulting to 3030
PORT=3030
CORS_ORIGIN=http://localhost:5173

# Company identity for payslip PDFs (no Org model in v1).
# Address lines are pipe-separated since commas occur inside addresses.
COMPANY_NAME=MyFactoryDesk
COMPANY_ADDRESS=
