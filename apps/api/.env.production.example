# Production environment for the self-hosted laptop deployment.
# Copy to apps/api/.env.production and fill in real secrets. NEVER commit the real file.
# See docs/DEPLOY.md for the full runbook.

NODE_ENV=production
# Container listens on 3000 (per apps/api/Dockerfile). Host-side port mapping
# is in docker-compose.prod.yml (3030 on the host). Don't change this unless
# you also update the Dockerfile and the compose port mapping.
PORT=3000

# Inside the compose network, postgres is reachable by service name.
# Replace <STRONG_PASSWORD> here AND set the same value in POSTGRES_PASSWORD below
# — compose substitutes it into the postgres container's POSTGRES_PASSWORD.
DATABASE_URL=postgresql://app:<STRONG_PASSWORD>@postgres:5432/myfactorydesk

# Consumed by docker-compose.prod.yml to initialize the postgres container.
# Must match the credentials embedded in DATABASE_URL above.
POSTGRES_DB=myfactorydesk
POSTGRES_USER=app
POSTGRES_PASSWORD=<STRONG_PASSWORD>

# Redis is deferred in v1 — no BullMQ workers are wired yet. Leave unset until
# payroll job runners need a queue.
# REDIS_URL=redis://redis:6379

# JWT secrets. Generate each with: openssl rand -hex 32
JWT_ACCESS_SECRET=<64_hex_chars>
JWT_REFRESH_SECRET=<64_hex_chars>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# AES-256-GCM key for PAN / Aadhaar at rest. 64 hex chars exactly.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=<64_hex_chars>

# Comma-separated allowed origins. Add the Vercel preview URL and (later) the
# eventual custom web domain. Example:
#   https://myfactorydesk-web.vercel.app,https://app.example.com
CORS_ORIGIN=https://<vercel-project>.vercel.app

# Company identity printed on payslip PDFs. Address lines are pipe-separated
# since commas occur inside addresses. Example:
#   COMPANY_ADDRESS=Plot 7, MIDC|Pune, Maharashtra 411019
COMPANY_NAME=MyFactoryDesk
COMPANY_ADDRESS=
