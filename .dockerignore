# Repo-wide ignores for the api Dockerfile (build context is the repo root).
**/node_modules
**/dist
**/.next
**/.turbo
**/.vite
**/coverage
**/.cache

# Env files are baked at runtime, never built into the image.
**/.env
**/.env.*
!**/.env.example

# VCS / editor / OS noise
.git
.gitignore
.idea
.vscode
.DS_Store
*.log

# Frontend assets are not needed in the api image.
apps/web

# Markdown / docs (keep image lean)
*.md
docs/
openspec/
